{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageHelperProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": "arn:aws:iam::638500336727:instance-profile/order-management-dev-inventory-tunnel"
    },
    {
      "Sid": "AttachOnlyManagedNodeCore",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::638500336727:role/order-management-dev-inventory-tunnel",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "PassOnlyHelperRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::638500336727:role/order-management-dev-inventory-tunnel",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageFixedForwardDocument",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateDocument",
        "ssm:UpdateDocument",
        "ssm:UpdateDocumentDefaultVersion",
        "ssm:DeleteDocument",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource"
      ],
      "Resource": "arn:aws:ssm:us-east-1:638500336727:document/order-management-dev-inventory-swagger-forward"
    },
    {
      "Sid": "LaunchTrustedImageAndSubnet",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/ami-0358f644d7299878d",
        "arn:aws:ec2:us-east-1:638500336727:subnet/subnet-0567a0a7cbc686bb3"
      ]
    },
    {
      "Sid": "LaunchWithHelperSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:638500336727:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Name": "order-management-dev-inventory-tunnel"
        }
      }
    },
    {
      "Sid": "LaunchOnlySmallImdsv2Helper",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:638500336727:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Name": "order-management-dev-inventory-tunnel",
          "aws:RequestTag/Project": "order-management-system",
          "ec2:InstanceType": "t4g.micro",
          "ec2:MetadataHttpTokens": "required",
          "ec2:InstanceProfile": "arn:aws:iam::638500336727:instance-profile/order-management-dev-inventory-tunnel"
        }
      }
    },
    {
      "Sid": "CreateOnlyEncryptedSmallRoot",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:638500336727:volume/*",
      "Condition": {
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericEquals": {
          "ec2:VolumeSize": "8"
        }
      }
    },
    {
      "Sid": "CreateLaunchInterface",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:638500336727:network-interface/*"
    },
    {
      "Sid": "TagHelperAtLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:638500336727:instance/*",
        "arn:aws:ec2:us-east-1:638500336727:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "RunInstances"
        }
      }
    },
    {
      "Sid": "ManageOnlyTaggedHelper",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:ModifyInstanceCreditSpecification",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:us-east-1:638500336727:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Name": "order-management-dev-inventory-tunnel"
        }
      }
    }
  ]
}
