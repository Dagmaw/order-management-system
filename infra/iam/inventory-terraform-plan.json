{
  "Statement": [
    {
      "Resource": "arn:aws:ecr:us-east-1:638500336727:repository/inventory-service",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:ListTagsForResource",
        "ecr:GetLifecyclePolicy"
      ],
      "Sid": "ReadInventoryRepository"
    },
    {
      "Resource": "arn:aws:iam::638500336727:role/order-management-dev-inventory-*",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Sid": "ReadInventoryRoles"
    },
    {
      "Resource": "arn:aws:secretsmanager:us-east-1:638500336727:secret:order-management/dev/inventory-database-*",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetResourcePolicy"
      ],
      "Sid": "ReadInventorySecretMetadata"
    },
    {
      "Resource": "arn:aws:acm:us-east-1:638500336727:certificate/*",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:ListTagsForCertificate"
      ],
      "Sid": "ReadCertificateMetadata"
    },
    {
      "Resource": "*",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeLoadBalancerAttributes",
        "elasticloadbalancing:DescribeListeners",
        "elasticloadbalancing:DescribeListenerAttributes",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetGroupAttributes",
        "elasticloadbalancing:DescribeTargetHealth",
        "elasticloadbalancing:DescribeTags"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "ReadRegionalLoadBalancerMetadata"
    },
    {
      "Resource": [
        "arn:aws:route53:::hostedzone/*",
        "arn:aws:route53:::change/*"
      ],
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:ListTagsForResource",
        "route53:GetChange"
      ],
      "Sid": "ReadDnsMetadata"
    },
    {
      "Resource": "*",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones",
        "route53:ListHostedZonesByName"
      ],
      "Sid": "ListDnsZones"
    },
    {
      "Resource": "*",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Sid": "DescribeRegionalLogs"
    },
    {
      "Resource": "arn:aws:logs:us-east-1:638500336727:log-group:/ecs/order-management-dev/inventory*",
      "Effect": "Allow",
      "Action": [
        "logs:ListTagsForResource",
        "logs:ListTagsLogGroup"
      ],
      "Sid": "ReadInventoryLogTags"
    },
    {
      "Resource": [
        "arn:aws:ecs:us-east-1:638500336727:service/order-management-dev/order-management-dev-inventory",
        "arn:aws:ecs:us-east-1:638500336727:task-definition/order-management-dev-inventory:*"
      ],
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTagsForResource"
      ],
      "Sid": "ReadInventoryEcs"
    }
  ],
  "Version": "2012-10-17"
}
