{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRegionalHelperMetadata",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeVolumes",
        "ec2:DescribeTags",
        "ec2:DescribeInstanceTypes"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ReadHelperProfile",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": "arn:aws:iam::638500336727:instance-profile/order-management-dev-inventory-tunnel"
    },
    {
      "Sid": "ReadHelperRoleProfiles",
      "Effect": "Allow",
      "Action": "iam:ListInstanceProfilesForRole",
      "Resource": "arn:aws:iam::638500336727:role/order-management-dev-inventory-tunnel"
    },
    {
      "Sid": "ReadFixedForwardDocument",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeDocument",
        "ssm:GetDocument",
        "ssm:ListTagsForResource",
        "ssm:DescribeDocumentPermission"
      ],
      "Resource": "arn:aws:ssm:us-east-1:638500336727:document/order-management-dev-inventory-swagger-forward"
    }
  ]
}
