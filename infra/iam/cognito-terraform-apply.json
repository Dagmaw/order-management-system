{
  "Statement": [
    {
      "Sid": "ReadCognitoConfiguration",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:GetUserPoolMfaConfig",
        "cognito-idp:ListTagsForResource",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:DescribeUserPoolDomain",
        "cognito-idp:DescribeResourceServer"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ReadServiceIdentitySecret",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:ListSecretVersionIds"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:us-east-1:638500336727:secret:order-management/dev/orders-service-identity-*"
    },
    {
      "Sid": "ReadVerificationRole",
      "Action": [
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:iam::638500336727:role/order-management-dev-service-identity-test"
    },
    {
      "Sid": "CreateTaggedServicePool",
      "Action": "cognito-idp:CreateUserPool",
      "Effect": "Allow",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "order-management-system",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ManageTaggedServicePool",
      "Action": [
        "cognito-idp:UpdateUserPool",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:SetUserPoolMfaConfig",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:UpdateUserPoolClient",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:CreateUserPoolDomain",
        "cognito-idp:UpdateUserPoolDomain",
        "cognito-idp:DeleteUserPoolDomain",
        "cognito-idp:CreateResourceServer",
        "cognito-idp:UpdateResourceServer",
        "cognito-idp:DeleteResourceServer",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:cognito-idp:us-east-1:638500336727:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "order-management-system"
        }
      }
    },
    {
      "Sid": "ManageDedicatedIdentitySecret",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecret",
        "secretsmanager:UpdateSecretVersionStage",
        "secretsmanager:DeleteSecret",
        "secretsmanager:RestoreSecret",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:us-east-1:638500336727:secret:order-management/dev/orders-service-identity-*"
    },
    {
      "Sid": "ManageOnlyVerificationRole",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:iam::638500336727:role/order-management-dev-service-identity-test"
    },
    {
      "Sid": "ReadAndCleanPrivatePlans",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::order-management-tfstate-dev-638500336727-us-east-1/reviewed-plans/*"
    }
  ],
  "Version": "2012-10-17"
}
