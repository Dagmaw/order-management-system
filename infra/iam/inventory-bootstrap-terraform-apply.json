{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInventoryBootstrapDefinition",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:ListTagsForResource"
      ],
      "Resource": "arn:aws:ecs:us-east-1:638500336727:task-definition/order-management-dev-inventory-bootstrap:*"
    },
    {
      "Sid": "PassOnlyBootstrapRolesToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::638500336727:role/order-management-dev-inventory-bootstrap-execution",
        "arn:aws:iam::638500336727:role/order-management-dev-inventory-bootstrap-task"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageOnlyBootstrapDefinition",
      "Effect": "Allow",
      "Action": [
        "ecs:TagResource",
        "ecs:UntagResource",
        "ecs:DeregisterTaskDefinition"
      ],
      "Resource": "arn:aws:ecs:us-east-1:638500336727:task-definition/order-management-dev-inventory-bootstrap:*"
    }
  ]
}
